            "value": "password"
          },
          {
            "name": "scope",
            "value": "api://{{clientId}}/productos.leer api://{{clientId}}/pedidos.escribir"
          },
          {
            "name": "username",
            "value": "{{usuarioAdmin}}"
          },
          {
            "name": "password",
            "value": "{{passwordAdmin}}"
          }
        ]
      },
      "tests": [
        {
          "type": "res-code",
          "custom": "",
          "action": "equal",
          "value": "200"
        },
        {
          "type": "set-env-var",
