{
  "info": {
    "_postman_id": "183357cf-30bf-47b3-b858-09784853ca4d",
    "name": "EXP1 — Pedidos360",
    "description": "Sistema Pedidos360: Entra ID como IDaaS, AWS API Gateway y microservicios Spring Boot.\n\nEjecutar primero '0. Token de Entra ID': guarda el access_token en la variable de coleccion y el resto lo toma solo.\n\nRellenar antes passwordAdmin.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Entra ID y registro de usuarios",
      "item": [
        {
          "name": "0. Token de Entra ID",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": {
              "raw": "https://login.microsoftonline.com/{{tenantId}}/oauth2/v2.0/token",
              "host": [
                "https://login.microsoftonline.com/{{tenantId}}/oauth2/v2.0/token"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "client_id",
                  "value": "{{clientId}}",
                  "type": "text"
                },
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "scope",
                  "value": "api://{{clientId}}/productos.leer api://{{clientId}}/pedidos.escribir",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "{{usuarioAdmin}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{passwordAdmin}}",
                  "type": "text"
                }
              ]
            },
            "description": "Obtiene un token de Entra por el flujo de contrasenia. El frontend usa Authorization Code con PKCE, que necesita navegador; este flujo sirve solo para automatizar pruebas y devuelve un token equivalente."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"token\", pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Registro de usuario en el tenant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/registro",
              "host": [
                "{{baseUrl}}/auth/registro"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario de prueba\",\n  \"usuario\": \"prueba.{{$timestamp}}\",\n  \"password\": \"{{passwordRegistro}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Crea una cuenta real en el tenant. El alias lleva {{$timestamp}} para que la peticion sea repetible: Entra rechaza con 400 un userPrincipalName que ya existe."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "7. Registro con datos invalidos (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/registro",
              "host": [
                "{{baseUrl}}/auth/registro"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"\",\n  \"usuario\": \"ab\",\n  \"password\": \"corta\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    },
