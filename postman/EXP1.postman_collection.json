    {
      "name": "2. Cognito (Identity as a Service)",
      "item": [
        {
          "name": "1. Token maquina a maquina",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{cognitoClientId}}"
                },
                {
                  "key": "password",
                  "value": "{{cognitoClientSecret}}"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                },
                {
                  "key": "scope",
                  "value": "exp1-api/productos.leer exp1-api/pedidos.escribir"
                }
              ]
            },
            "url": {
              "raw": "https://{{cognitoDominio}}.auth.us-east-1.amazoncognito.com/oauth2/token",
              "host": [
                "https://{{cognitoDominio}}.auth.us-east-1.amazoncognito.com"
              ],
              "path": [
                "oauth2",
                "token"
              ]
            },
            "description": "Flujo client_credentials. Rellenar antes cognitoClientId y cognitoClientSecret en las variables de la coleccion.\n\nEl scope viene prefijado con el resource server: 'exp1-api/pedidos.escribir'."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const datos = pm.response.json();",
                  "pm.collectionVariables.set('token', datos.access_token);",
                  "pm.test('Codigo 200', () => pm.response.to.have.status(200));",
                  "console.log('Token de Cognito guardado. Ojo: el autorizador del API Gateway',",
                  "            'valida el IdP propio, asi que por el gateway dara 401.',",
                  "            'Este token si funciona llamando directo a los microservicios.');"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
