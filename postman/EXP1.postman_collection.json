{
  "info": {
    "name": "EXP1 - Arquitectura segura con OIDC",
    "description": "Coleccion de pruebas de la Experiencia 1.\n\nOrden sugerido:\n1. Ejecutar '1. Login IdP propio' — guarda el token en la variable de coleccion.\n2. El resto de las peticiones lo usan automaticamente.\n\nLa variable baseUrl apunta al stage del API Gateway. Para probar en local, cambiarla por http://localhost:9000, :8081 o :8082 segun el servicio.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://j37oj1wn16.execute-api.us-east-1.amazonaws.com/desarrollo",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "cognitoDominio",
      "value": "exp1-oidc-u4gmyfk",
      "type": "string"
    },
    {
      "key": "cognitoClientId",
      "value": "",
      "type": "string"
    },
    {
      "key": "cognitoClientSecret",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Identity Provider propio",
      "item": [
        {
          "name": "1. Login IdP propio",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Emite access_token e id_token firmados en RS256. El script de test guarda el token.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const datos = pm.response.json();",
                  "pm.collectionVariables.set('token', datos.access_token);",
                  "pm.test('Devuelve access_token', () => pm.expect(datos.access_token).to.be.a('string'));",
                  "pm.test('Codigo 200', () => pm.response.to.have.status(200));",
                  "console.log('Token guardado en la variable {{token}}');"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Login con credenciales invalidas (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Evidencia del rechazo de credenciales.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"incorrecta\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Codigo 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Userinfo (protegido)",
          "request": {
            "method": "GET",
            "header": [],
