# Copiar a .env y rellenar. El archivo .env esta en .gitignore: nunca se commitea.

# ---------- IdP propio (ms-auth) ----------
# En local el issuer es el propio host; en AWS es la URL del stage del API Gateway.
OIDC_ISSUER=http://localhost:9000
OIDC_AUDIENCIA=exp1-api

# ---------- Emisores confiables de los Resource Server ----------
# Lista separada por coma. Se agregan Cognito y Entra ID sin tocar codigo.
SEGURIDAD_EMISORES=https://login.microsoftonline.com/TU_TENANT_ID/v2.0
# Audiencias aceptadas: el Client ID de la app en Entra
SEGURIDAD_AUDIENCIAS=TU_CLIENT_ID

# ---------- Cognito (solo para pedir tokens desde Postman o curl) ----------
COGNITO_DOMINIO=tu-dominio
COGNITO_CLIENT_ID=tu_client_id
COGNITO_CLIENT_SECRET=tu_client_secret


# ---------- Frontend (Vite las incrusta en el bundle al construir) ----------
VITE_REDIRECT_URI=http://localhost:5173
VITE_API_PRODUCTOS=http://localhost:8081
VITE_API_PEDIDOS=http://localhost:8082
VITE_API_AUTH=http://localhost:9000

# Origen del frontend que aceptan los Resource Server por CORS
SEGURIDAD_ORIGENES_CORS=http://localhost:5173

# ---------- Base de datos cloud (RDS MySQL) ----------
# En AWS: el endpoint del RDS. En local con docker-compose: mysql
DB_HOST=mysql
DB_PUERTO=3306
DB_NOMBRE=pedidos360
DB_USUARIO=pedidos360
DB_PASSWORD=cambiar
DB_ROOT_PASSWORD=cambiar

# ---------- Entra ID (Identity as a Service) ----------
ENTRA_TENANT_ID=tu_tenant_id
ENTRA_CLIENT_ID=tu_client_id
ENTRA_DOMINIO=tu_tenant.onmicrosoft.com
ENTRA_EMISOR=https://login.microsoftonline.com/tu_tenant_id/v2.0
ENTRA_APP_ID_URI=api://tu_client_id

# Usuarios de prueba del tenant
ENTRA_USUARIO_ADMIN=admin@tu_tenant.onmicrosoft.com
ENTRA_PASSWORD_ADMIN=cambiar
ENTRA_USUARIO_CLIENTE=cliente@tu_tenant.onmicrosoft.com
ENTRA_PASSWORD_CLIENTE=cambiar

# Frontend
VITE_ENTRA_CLIENT_ID=tu_client_id
VITE_ENTRA_TENANT_ID=tu_tenant_id
VITE_ENTRA_SCOPE_API=api://tu_client_id/productos.leer

# ---------- App de backend en Entra (registro via Microsoft Graph) ----------
# Cliente confidencial con permisos de aplicacion User.ReadWrite.All y
# AppRoleAssignment.ReadWrite.All, ambos con consentimiento de administrador.
GRAPH_CLIENT_ID=tu_client_id_de_backend
GRAPH_CLIENT_SECRET=tu_secreto
GRAPH_ROL_USER_ID=id_del_rol_USER_de_la_app
GRAPH_SP_APLICACION=object_id_del_service_principal_de_la_app_spa

# Base href del frontend Angular: en AWS cuelga del stage del API Gateway
BASE_HREF=/desarrollo/
