# Copiar a .env y rellenar. El archivo .env esta en .gitignore: nunca se commitea.

# ---------- IdP propio (ms-auth) ----------
# En local el issuer es el propio host; en AWS es la URL del stage del API Gateway.
OIDC_ISSUER=http://localhost:9000
OIDC_AUDIENCIA=exp1-api

# ---------- Emisores confiables de los Resource Server ----------
# Lista separada por coma. Se agregan Cognito y Entra ID sin tocar codigo.
SEGURIDAD_EMISORES=http://localhost:9000,https://cognito-idp.us-east-1.amazonaws.com/TU_POOL_ID

# ---------- Cognito (solo para pedir tokens desde Postman o curl) ----------
COGNITO_DOMINIO=tu-dominio
COGNITO_CLIENT_ID=tu_client_id
COGNITO_CLIENT_SECRET=tu_client_secret

# ---------- Entra ID ----------
ENTRA_TENANT_ID=tu_tenant_id
ENTRA_CLIENT_ID=tu_client_id

# ---------- Frontend (Vite las incrusta en el bundle al construir) ----------
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_SCOPE_API=
VITE_REDIRECT_URI=http://localhost:5173
VITE_API_PRODUCTOS=http://localhost:8081
VITE_API_PEDIDOS=http://localhost:8082
VITE_API_AUTH=http://localhost:9000

# Origen del frontend que aceptan los Resource Server por CORS
SEGURIDAD_ORIGENES_CORS=http://localhost:5173
