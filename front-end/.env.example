# Copiar a .env.local y rellenar con los datos de tu registro en Entra ID.

# Application (client) ID del registro de aplicaciones
VITE_ENTRA_CLIENT_ID=
# Directory (tenant) ID
VITE_ENTRA_TENANT_ID=
# Debe coincidir EXACTAMENTE con el Redirect URI configurado en Azure (tipo SPA)
VITE_REDIRECT_URI=http://localhost:5173
# Scope de tu propia API expuesta en Azure. Un scope de Graph NO sirve.
VITE_ENTRA_SCOPE_API=

# URL base de la API. En desarrollo apunta directo a los microservicios;
# en AWS, a la URL del stage del API Gateway.
VITE_API_PRODUCTOS=http://localhost:8081
VITE_API_PEDIDOS=http://localhost:8082
VITE_API_AUTH=http://localhost:9000
